
# Base URL
@baseUrl = http://localhost:3000

### Root endpoint
GET {{baseUrl}}/


###
GET {{baseUrl}}/api


### Create a new user
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "first_name": "Joshua",
  "last_name": "Ngigi",
  "email": "joshua@gmail.com",
  "phone_number": "0797390822",
  "user_type": "customer",
  "password":"123456789"
  
}

### Admin Login
POST http://localhost:3000/api/auth/login
Content-Type: application/json


{
  "email": "joshua@gmail.com",
  "password": "123456789"
}

### user login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "denis@gmail.com",
  "password": "password123"
}



### Update user
PUT http://localhost:3000/api/users/2
Content-Type: application/json

{
  "first_name": "denis",
  "last_name": "kathuri",
  "email": "denis@gmail.com",
  "phone_number": "0723356478",
  "password": "password123"
}

